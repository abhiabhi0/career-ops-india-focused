# Serper.dev API key for Google Search queries in Phase 3.
# Get a free key (2,500 queries) at https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Optional: Override the python executable used by Scrapling (default: uses python3 from .venv-scrapling)
# SCRAPLING_PYTHON=/usr/bin/python3

# Optional: Set the fetcher mode for Scrapling ("stealthy" or "playwright")
# SCRAPLING_FETCHER=stealthy

# Optional: Maximum pages to scrape per company website in Phase 2
# SCRAPLING_MAX_PAGES=50
